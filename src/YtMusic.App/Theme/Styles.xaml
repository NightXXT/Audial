<?xml version="1.0" encoding="utf-8"?>
<!--
  Audial · Tema "Audial Fluent" · substitui Theme/Styles.xaml.
  Mesmas chaves e tipos da v8.6 (Border, Button, Grid), todos os botões
  continuam baseados no DefaultButtonStyle do WinUI.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Raiz de cada página -->
    <Style x:Key="Page.Root" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource Padding.Page}" />
    </Style>

    <!-- Cartões: superfície elevada com borda fina "de vidro" -->
    <Style x:Key="Card.Border" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>

    <!-- Botão principal: rosa, texto branco, formato de pílula -->
    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="22,10,22,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Botão secundário "vidro": fundo sutil com borda fina -->
    <Style x:Key="Button.Glass" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.Subtle}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18,10,18,10" />
    </Style>

    <!-- Botão só de ícone (player, fila etc.) -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Itens da barra lateral -->
    <Style x:Key="Button.Nav" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9,12,9" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Faixa de aviso (ex.: modo demonstração) -->
    <Style x:Key="Banner.Warning" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Warning}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6,12,6" />
    </Style>

    <!-- NOVO: estilos extras do design -->

    <!-- Botão de play redondo grande (barra do player e Tocando agora) -->
    <Style x:Key="Button.Play" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Width" Value="{StaticResource Size.PlayButton}" />
        <Setter Property="Height" Value="{StaticResource Size.PlayButton}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Chip de filtro (Tudo, Músicas, Playlists...) -->
    <Style x:Key="Button.Chip" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,6,14,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Painéis da janela (barra lateral, barra do player) -->
    <Style x:Key="Panel.Surface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    </Style>
</ResourceDictionary>
