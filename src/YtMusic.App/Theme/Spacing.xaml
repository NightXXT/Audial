<?xml version="1.0" encoding="utf-8"?>
<!--
  Audial · Tema "Audial Fluent" · substitui Theme/Spacing.xaml.
  Mesmas chaves e tipos da v8.6. Os valores antigos estão nos comentários.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Escala de espaçamento (igual à anterior) -->
    <x:Double x:Key="Space.XS">4</x:Double>
    <x:Double x:Key="Space.S">8</x:Double>
    <x:Double x:Key="Space.M">16</x:Double>
    <x:Double x:Key="Space.L">24</x:Double>
    <x:Double x:Key="Space.XL">32</x:Double>

    <!-- Estrutura da janela -->
    <x:Double x:Key="Size.SidePanel.Width">240</x:Double>       <!-- antes 296 -->
    <x:Double x:Key="Size.PlayerBar.Height">88</x:Double>       <!-- antes 104 (se cortar algo, volte para 104) -->

    <!-- Capas -->
    <x:Double x:Key="Size.Artwork.Row">40</x:Double>            <!-- antes 44 -->
    <x:Double x:Key="Size.Artwork.PlayerBar">56</x:Double>      <!-- igual -->
    <x:Double x:Key="Size.Artwork.Card">180</x:Double>          <!-- antes 168 -->

    <!-- Cantos -->
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>         <!-- antes 8 -->
    <CornerRadius x:Key="Radius.Artwork">8</CornerRadius>       <!-- antes 6 -->

    <!-- Margens internas -->
    <Thickness x:Key="Padding.Page">24,20,24,24</Thickness>     <!-- antes 28,20,28,24 -->
    <Thickness x:Key="Padding.Card">16</Thickness>              <!-- antes 12 -->

    <!-- NOVO: tokens extras do design -->
    <CornerRadius x:Key="Radius.Button">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">20</CornerRadius>
    <x:Double x:Key="Size.TrackRow.Height">56</x:Double>
    <x:Double x:Key="Size.PlayButton">48</x:Double>
    <x:Double x:Key="Size.PlayButton.Large">72</x:Double>
    <x:Double x:Key="Size.SidePanel.Compact">64</x:Double>
    <x:Double x:Key="Size.RightDrawer.Width">320</x:Double>
</ResourceDictionary>
