<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:platform="using:YtMusic.App.Platform" xmlns:dt0="using:YtMusic.Core.Models" x:Class="YtMusic.App.Views.QueuePage">
    <Grid Style="{StaticResource Page.Root}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="SESSÃO ATIVA" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Rose}" />
                <TextBlock Text="Fila de reprodução" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource Text.Secondary}" />
            </StackPanel>
            <Button Command="{x:Bind ViewModel.ClearCommand}" Style="{StaticResource Button.Glass}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Limpar fila" />
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay}">
            <TextBlock Text="TOCANDO AGORA" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Rose}" />
            <Border Padding="20" CornerRadius="16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF1A1B20" Offset="0" />
                        <GradientStop Color="#FF3A1F2C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" CornerRadius="12" Background="{StaticResource Brush.AccentGradient}">
                        <Image Source="{x:Bind platform:UiHelpers.Image(ViewModel.Current.ArtworkUrl), Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{StaticResource Brush.Accent}" CornerRadius="9" Padding="8,2">
                                <TextBlock Text="REPRODUZINDO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.AccentText}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.Position, Mode=OneWay}" Style="{StaticResource Text.Time}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Current.Title, Mode=OneWay}" Style="{StaticResource Text.Heading}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.Current.Artist, Mode=OneWay}" Style="{StaticResource Text.Secondary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="A seguir" Style="{StaticResource Text.Heading}" Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay}" />
        <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE8FD;" FontSize="36" Foreground="{StaticResource Brush.TextSecondary}" />
            <TextBlock Text="A fila está vazia. Toque uma playlist ou adicione faixas com o botão +." Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" />
        </StackPanel>
        <ListView ItemClick="OnItemClick" ItemsSource="{x:Bind ViewModel.UpNext}" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                    <Setter Property="CornerRadius" Value="12" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dt0:Track">
                    <Grid ColumnSpacing="12" Height="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource Brush.SurfaceRaised}">
                            <Image Source="{x:Bind platform:UiHelpers.Image(ArtworkUrl)}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource Text.Body}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Artist}" Style="{StaticResource Text.Time}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind platform:UiHelpers.Duration(Duration)}" Grid.Column="2" Style="{StaticResource Text.Time}" VerticalAlignment="Center" />
                        <Button Click="OnRemoveClick" Grid.Column="3" Style="{StaticResource Button.Icon}" ToolTipService.ToolTip="Remover da fila" AutomationProperties.Name="Remover da fila">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
