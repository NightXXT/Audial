<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:YtMusic.App.Controls" xmlns:platform="using:YtMusic.App.Platform" xmlns:dt0="using:YtMusic.Core.Models" x:Class="YtMusic.App.Views.TrackListPage">
    <Grid Style="{StaticResource Page.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListView ItemClick="OnTrackClick" ItemsSource="{x:Bind ViewModel.Tracks}" SelectionMode="None" IsItemClickEnabled="True">
            <ListView.Header>
                <StackPanel Spacing="16" Margin="0,0,0,8">
                    <Border Padding="24" CornerRadius="16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF3A1F2C" Offset="0" />
                                <GradientStop Color="#FF1A1B2A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="200" Height="200" CornerRadius="12" Background="{StaticResource Brush.AccentGradient}">
                                <Image x:Name="HeroImage" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="10">
                                <Border HorizontalAlignment="Left" Background="#33F43F5E" CornerRadius="10" Padding="10,3">
                                    <TextBlock Text="PLAYLIST" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Rose}" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource Text.Display}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackCount" Style="{StaticResource Text.Secondary}" />
                                <Button Command="{x:Bind ViewModel.PlayAllCommand}" Visibility="{x:Bind ViewModel.IsContent, Mode=OneWay}" Style="{StaticResource Button.Accent}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="Reproduzir" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid ColumnSpacing="16" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TÍTULO" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="ÁLBUM" Style="{StaticResource Text.Label}" />
                        <FontIcon Grid.Column="2" Glyph="&#xE823;" FontSize="13" HorizontalAlignment="Left" Foreground="{StaticResource Brush.TextSecondary}" />
                    </Grid>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dt0:Track">
                    <Grid ColumnSpacing="16" Height="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="{StaticResource Size.Artwork.Row}" Height="{StaticResource Size.Artwork.Row}" CornerRadius="6" Background="{StaticResource Brush.SurfaceRaised}">
                                <Image Source="{x:Bind platform:UiHelpers.Image(ArtworkUrl)}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource Text.Body}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Artist}" Style="{StaticResource Text.Time}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Album}" Style="{StaticResource Text.Time}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind platform:UiHelpers.Duration(Duration)}" Style="{StaticResource Text.Time}" VerticalAlignment="Center" />
                        <Button Click="OnEnqueueClick" Grid.Column="3" Style="{StaticResource Button.Icon}" ToolTipService.ToolTip="Adicionar à fila" AutomationProperties.Name="Adicionar à fila">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <controls:StatePanel SignInCommand="{x:Bind ViewModel.SignInCommand}" RetryCommand="{x:Bind ViewModel.ReloadCommand}" Message="{x:Bind ViewModel.StateMessage, Mode=OneWay}" State="{x:Bind ViewModel.State, Mode=OneWay}" Margin="0,300,0,0" />
        <Button Command="{x:Bind ViewModel.LoadMoreCommand}" Visibility="{x:Bind platform:UiHelpers.Visible(ViewModel.HasMore), Mode=OneWay}" Grid.Row="1" Content="Carregar mais faixas" Style="{StaticResource Button.Glass}" HorizontalAlignment="Center" Margin="0,8,0,4" />
    </Grid>
</Page>
